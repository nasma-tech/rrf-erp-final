use * from '../brands/brands'
use * from '../users/users'

Table warehouseDefinition {
  id int [pk, increment]
  label varchar(191)
  brand_id int [ref:-brands.id]
  type_id int [ref:-warehouceType.id]
}
Table warehouceType{
id int [pk,increment]
label varchar(191)
user_id int [ref:-users.id]
created_at dateTime
update_at dateTime
deleted_at dateTime
}