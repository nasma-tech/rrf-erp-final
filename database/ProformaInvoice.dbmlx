!include "Contact.dbmlx"

enum official_proforma_invoice_status {
    yes
    no
}

Table ProformaInvoice {
    id bigint [pk, increment]
    proforma_invoice_number varchar(191) [not null]
    official_proforma_invoice official_proforma_invoice_status [note: 'پیشفاکتور رسمی است؟', not null, default:"yes"]    
    contact_id bigint [not null]
    sale_team_id bigint [not null]
    company_id bigint [not null]
    issue_date varchar(255) [not null]
    validity tinyint(3) [not null]
    country_id bigint [not null]
    state_id bigint [not null]
    city_id bigint [not null]
    marketer_id bigint [null]
    marketer_commission_percent char(3)
    total varchar(255)
    total_discount varchar(255)
    net_Total varchar(255)

}

Ref: ProformaInvoice.contact_id > Contact.id
